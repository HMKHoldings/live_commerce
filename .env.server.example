HOST=127.0.0.1
PORT=3111
DB_PATH=backend/data/store.sqlite
UPLOAD_DIR=backend/data/uploads
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3111
# Production: NODE_ENV=production, HTTPS reverse proxy, exact HTTPS origins above.

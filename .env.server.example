# Copy to .env.server. Never commit .env.server or the database.
HOST=127.0.0.1
PORT=3111
DB_PATH=backend/data/store.sqlite
UPLOAD_DIR=backend/data/uploads
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3111
# Production: NODE_ENV=production, HTTPS reverse proxy, exact HTTPS origins above.

# Account recovery email. Set these in .env.server, then restart the backend.
# SMTP_FROM must be an address authorized by your email provider.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

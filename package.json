{
    "name": "orange-store",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite --host 0.0.0.0",
        "build": "vite build",
        "preview": "vite preview --host 0.0.0.0",
        "server": "node --env-file-if-exists=.env.server backend/index.mjs",
        "admin:create": "node --env-file-if-exists=.env.server backend/create-admin.mjs",
        "test:server": "node --test backend/tests/*.test.mjs",
        "backup": "node --env-file-if-exists=.env.server backend/backup.mjs"
    },
    "dependencies": {
        "lucide-react": "^0.468.0",
        "nodemailer": "^10.0.1",
        "react": "^19.1.0",
        "react-dom": "^19.1.0"
    },
    "devDependencies": {
        "vite": "^6.1.0"
    }
}
